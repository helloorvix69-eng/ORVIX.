
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f5f5f2">
<meta name="description" content="ORVIX is an independent technology company founded by Ayush Kumar. We build digital experiences, intelligent software and modern web solutions.">
<meta name="keywords" content="ORVIX, technology, AI, software development, web development, automation">
<meta name="author" content="Ayush Kumar">

<title>ORVIX — Technology Without Limits</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --light: #f5f5f2;
  --white: #ffffff;
  --dark: #101827;
  --dark2: #18243a;
  --blue: #4169ff;
  --blue2: #7290ff;
  --gray: #777d89;
  --border: rgba(16,24,39,.12);
  --radius: 20px;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  font-family: 'Inter', sans-serif;
  background: var(--light);
  color: var(--dark);
  overflow-x: hidden;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  font-family: inherit;
  cursor: pointer;
}

.container {
  width: min(1160px, 90%);
  margin: auto;
}

/* NAVIGATION */

header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: rgba(245,245,242,.86);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
}

nav {
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 27px;
  font-weight: 700;
  letter-spacing: -1.8px;
}

.logo span {
  color: var(--blue);
}

.nav-links {
  display: flex;
  gap: 30px;
  align-items: center;
}

.nav-links a {
  font-size: 13px;
  font-weight: 600;
  color: #4c5360;
  transition: .3s;
}

.nav-links a:hover {
  color: var(--blue);
}

.nav-btn {
  background: var(--dark);
  color: white !important;
  padding: 12px 20px;
  border-radius: 8px;
}

.menu-btn {
  display: none;
  background: none;
  border: none;
  font-size: 25px;
  color: var(--dark);
}

/* HERO */

.hero {
  min-height: 790px;
  padding: 155px 0 95px;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  width: 570px;
  height: 570px;
  right: -150px;
  top: 100px;
  background: radial-gradient(circle,rgba(65,105,255,.16),transparent 70%);
  pointer-events: none;
}

.hero-content {
  max-width: 790px;
  position: relative;
  z-index: 2;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 9px 15px;
  border: 1px solid var(--border);
  border-radius: 50px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  color: var(--blue);
  margin-bottom: 30px;
  background: white;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4169ff;
  box-shadow: 0 0 10px #4169ff;
}

.hero h1 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(52px, 8vw, 100px);
  line-height: .99;
  letter-spacing: -6px;
  font-weight: 700;
}

.hero h1 span {
  color: var(--blue);
}

.hero-description {
  margin-top: 30px;
  color: var(--gray);
  font-size: 16px;
  line-height: 1.9;
  max-width: 550px;
}

.hero-buttons {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 35px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 24px;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 700;
  transition: .3s;
}

.btn-primary {
  background: var(--blue);
  color: white;
  box-shadow: 0 8px 24px rgba(65,105,255,.23);
}

.btn-primary:hover {
  background: #254ce8;
  transform: translateY(-3px);
}

.btn-outline {
  border: 1px solid var(--border);
  background: white;
}

.btn-outline:hover {
  border-color: var(--blue);
  color: var(--blue);
}

.hero-bottom {
  margin-top: 90px;
  padding-top: 25px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  color: var(--gray);
  font-size: 11px;
  letter-spacing: 1px;
  font-weight: 600;
}

/* GENERAL SECTIONS */

section {
  padding: 110px 0;
}

.section-tag {
  color: var(--blue);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 17px;
}

.section-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(35px,5vw,57px);
  line-height: 1.12;
  letter-spacing: -2px;
  max-width: 720px;
}

.section-desc {
  color: var(--gray);
  line-height: 1.9;
  max-width: 600px;
  margin-top: 20px;
  font-size: 14px;
}

/* ABOUT */

.about {
  background: var(--dark);
  color: white;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  align-items: center;
}

.about .section-desc {
  color: #a8b0bf;
}

.about-box {
  padding: 35px;
  border: 1px solid rgba(255,255,255,.13);
  background: rgba(255,255,255,.045);
  border-radius: var(--radius);
}

.about-box h3 {
  font-family: 'Space Grotesk';
  font-size: 30px;
  margin-bottom: 15px;
}

.about-box p {
  color: #a8b0bf;
  line-height: 1.9;
  font-size: 13px;
}

/* SERVICES */

.services-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 18px;
  margin-top: 50px;
}

.service-card {
  padding: 30px;
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: .35s;
}

.service-card:hover {
  transform: translateY(-8px);
  border-color: var(--blue);
  box-shadow: 0 15px 40px rgba(16,24,39,.07);
}

.service-icon {
  width: 49px;
  height: 49px;
  display: grid;
  place-items: center;
  background: #edf0ff;
  color: var(--blue);
  border-radius: 13px;
  font-size: 22px;
  margin-bottom: 27px;
}

.service-card h3 {
  font-family: 'Space Grotesk';
  font-size: 19px;
  margin-bottom: 12px;
}

.service-card p {
  color: var(--gray);
  line-height: 1.8;
  font-size: 12px;
}

/* PORTFOLIO */

.portfolio {
  background: #eceeea;
}

.portfolio-heading {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: end;
  flex-wrap: wrap;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 25px;
  margin-top: 50px;
}

.project {
  background: white;
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid var(--border);
  transition: .3s;
}

.project:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(16,24,39,.09);
}

.project-art {
  height: 270px;
  background: var(--dark);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.project-art.blue-art {
  background: linear-gradient(135deg,#172c62,#4169ff);
}

.project-art.light-art {
  background: #e8ebf5;
}

.project-art.black-art {
  background: #101827;
}

.art-circle {
  width: 190px;
  height: 190px;
  border-radius: 50%;
  background: linear-gradient(135deg,#dce5ff,#4169ff);
  box-shadow: 0 0 80px rgba(114,144,255,.4);
  display: grid;
  place-items: center;
  color: white;
  font-family: 'Space Grotesk';
  font-size: 45px;
  font-weight: 700;
  transition: .5s;
}

.project:hover .art-circle {
  transform: rotate(15deg) scale(1.08);
}

.art-text {
  font-family: 'Space Grotesk';
  font-size: 42px;
  font-weight: 700;
  letter-spacing: -2px;
}

.project-info {
  padding: 25px;
}

.project-info h3 {
  font-family: 'Space Grotesk';
  font-size: 22px;
}

.project-info p {
  color: var(--gray);
  font-size: 12px;
  line-height: 1.8;
  margin-top: 9px;
}

.project-type {
  display: inline-block;
  margin-bottom: 12px;
  font-size: 10px;
  font-weight: 700;
  color: var(--blue);
  letter-spacing: 1px;
}

/* DOMAIN */

.domain {
  background: var(--dark);
  color: white;
}

.domain-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 60px;
}

.domain .section-desc {
  color: #a8b0bf;
}

.domain-box {
  padding: 35px;
  border-radius: var(--radius);
  border: 1px solid rgba(255,255,255,.15);
  background: rgba(255,255,255,.05);
}

.domain-name {
  font-family: 'Space Grotesk';
  font-size: clamp(25px,4vw,40px);
  font-weight: 700;
  letter-spacing: -2px;
  word-break: break-word;
}

.domain-name span {
  color: #7290ff;
}

.domain-status {
  margin-top: 15px;
  color: #9da9bb;
  font-size: 12px;
}

/* PROCESS */

.process-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 15px;
  margin-top: 50px;
}

.process-card {
  padding: 25px 20px;
  border-top: 2px solid var(--blue);
  background: white;
}

.process-number {
  font-family: 'Space Grotesk';
  font-size: 35px;
  color: var(--blue);
  margin-bottom: 20px;
}

.process-card h3 {
  font-size: 15px;
  margin-bottom: 10px;
}

.process-card p {
  color: var(--gray);
  font-size: 12px;
  line-height: 1.8;
}

/* FOUNDER */

.founder {
  background: #eceeea;
}

.founder-card {
  background: var(--dark);
  color: white;
  padding: 55px;
  border-radius: 25px;
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 55px;
  align-items: center;
}

.founder-avatar {
  width: 180px;
  height: 180px;
  border-radius: 25px;
  background: linear-gradient(135deg,#4169ff,#101827);
  display: grid;
  place-items: center;
  font-family: 'Space Grotesk';
  font-size: 65px;
  font-weight: 700;
  box-shadow: 0 20px 50px rgba(65,105,255,.2);
}

.founder-card .section-desc {
  color: #a8b0bf;
}

.founder-name {
  font-family: 'Space Grotesk';
  font-size: 40px;
  margin-top: 12px;
}

.founder-role {
  color: #7290ff;
  font-size: 12px;
  font-weight: 700;
  margin-top: 8px;
  letter-spacing: 1px;
}

/* CONTACT */

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  margin-top: 40px;
}

.contact-form {
  display: grid;
  gap: 15px;
}

.contact-form input,
.contact-form textarea,
.contact-form select {
  width: 100%;
  padding: 16px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 9px;
  font-family: inherit;
  font-size: 13px;
  outline: none;
}

.contact-form input:focus,
.contact-form textarea:focus,
.contact-form select:focus {
  border-color: var(--blue);
}

.contact-form textarea {
  min-height: 140px;
  resize: vertical;
}

.contact-info {
  padding: 30px;
  background: white;
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.contact-info h3 {
  font-family: 'Space Grotesk';
  font-size: 24px;
  margin-bottom: 20px;
}

.contact-info p {
  color: var(--gray);
  font-size: 13px;
  line-height: 2;
}

/* CTA */

.cta {
  padding: 90px 0;
  background: var(--blue);
  color: white;
  text-align: center;
}

.cta h2 {
  font-family: 'Space Grotesk';
  font-size: clamp(35px,5vw,58px);
  letter-spacing: -2px;
}

.cta p {
  margin: 20px auto 30px;
  color: rgba(255,255,255,.8);
  font-size: 14px;
  line-height: 1.8;
  max-width: 550px;
}

.cta .btn {
  background: white;
  color: var(--dark);
}

/* FOOTER */

footer {
  background: #0b111c;
  color: white;
  padding: 55px 0 25px;
}

.footer-top {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  flex-wrap: wrap;
  padding-bottom: 40px;
}

.footer-logo {
  font-family: 'Space Grotesk';
  font-size: 32px;
  font-weight: 700;
}

.footer-logo span {
  color: #7290ff;
}

.footer-desc {
  color: #8994a6;
  font-size: 12px;
  margin-top: 12px;
  max-width: 280px;
  line-height: 1.8;
}

.footer-links {
  display: flex;
  gap: 25px;
  flex-wrap: wrap;
  align-items: center;
}

.footer-links a {
  color: #a8b0bf;
  font-size: 12px;
}

.footer-links a:hover {
  color: #7290ff;
}

.footer-bottom {
  padding-top: 22px;
  border-top: 1px solid rgba(255,255,255,.1);
  color: #7e899a;
  display: flex;
  justify-content: space-between;
  gap: 15px;
  flex-wrap: wrap;
  font-size: 11px;
}

/* ANIMATIONS */

.reveal {
  opacity: 0;
  transform: translateY(25px);
  transition: opacity .7s ease, transform .7s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* MOBILE */

@media(max-width:850px) {
  .menu-btn {
    display: block;
  }

  .nav-links {
    position: absolute;
    top: 76px;
    left: 0;
    width: 100%;
    background: var(--light);
    padding: 25px 5%;
    flex-direction: column;
    align-items: flex-start;
    gap: 23px;
    border-bottom: 1px solid var(--border);
    display: none;
  }

  .nav-links.active {
    display: flex;
  }

  .about-grid,
  .domain-content,
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .services-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .process-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .founder-card {
    grid-template-columns: 1fr;
    padding: 35px;
  }

  .hero {
    min-height: auto;
    padding: 150px 0 70px;
  }
}

@media(max-width:550px) {
  .hero h1 {
    letter-spacing: -3px;
  }

  section {
    padding: 80px 0;
  }

  .services-grid,
  .project-grid,
  .process-grid {
    grid-template-columns: 1fr;
  }

  .project-art {
    height: 220px;
  }

  .hero-bottom {
    margin-top: 60px;
  }

  .founder-card {
    padding: 27px;
  }

  .founder-name {
    font-size: 32px;
  }

  .footer-top {
    flex-direction: column;
  }
}

@media(prefers-reduced-motion:reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
  }
}
</style>
</head>

<body>

<header>
  <div class="container">
    <nav>
      <a href="#home" class="logo">ORV<span>IX</span>.</a>

      <button class="menu-btn" id="menuBtn" aria-label="Open menu">☰</button>

      <div class="nav-links" id="navLinks">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#portfolio">Portfolio</a>
        <a href="#founder">Founder</a>
        <a href="#contact" class="nav-btn">Let's Talk ↗</a>
      </div>
    </nav>
  </div>
</header>

<!-- HERO -->

<main>
<section class="hero" id="home">
  <div class="container">
    <div class="hero-content reveal">

      <div class="eyebrow">
        <span class="dot"></span>
        INDEPENDENT TECHNOLOGY COMPANY
      </div>

      <h1>
        Technology<br>
        without <span>limits.</span>
      </h1>

      <p class="hero-description">
        We imagine, design and build digital experiences
